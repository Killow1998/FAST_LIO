foreach(name imu_initialization imu_process_initialization core_pipeline)
  set(sources ${FAST_LIO_ROOT}/test/${name}.cpp ${FAST_LIO_ROOT}/test/main.cpp)
  if(COMMAND ament_add_gtest)
    ament_add_gtest(test_${name} ${sources} SKIP_LINKING_MAIN_LIBRARIES)
  elseif(COMMAND catkin_add_gtest)
    catkin_add_gtest(test_${name} ${sources})
  else()
    add_executable(test_${name} ${sources})
    target_link_libraries(test_${name} GTest::gtest)
    add_test(NAME test_${name} COMMAND test_${name})
  endif()
  if(TARGET test_${name})
    target_include_directories(test_${name} PRIVATE ${FAST_LIO_ROOT}/src ${GTEST_INCLUDE_DIRS})
    target_link_libraries(test_${name} fast_lio_core)
  endif()
endforeach()

if(TARGET test_core_pipeline)
  target_link_libraries(test_core_pipeline pcl_io)
endif()
